{
  "name": "@hugojosefson/dropbear-auto-unlock",
  "version": "1.0.1",
  "exports": {
    "./cli": "./src/cli/cli.ts",
    ".": "./src/lib/mod.ts",
    "./example-usage": "./readme/example-usage.ts"
  },
  "tasks": {
    "all": {
      "description": "Run all checks.",
      "dependencies": [
        "check"
      ]
    },
    "check": {
      "description": "Run project checks.",
      "dependencies": [
        "format",
        "lint",
        "typecheck",
        "test",
        "test-compiled-consumer",
        "publish-check"
      ]
    },
    "fmt": {
      "description": "Fix formatting.",
      "command": "deno fmt"
    },
    "format": {
      "description": "Check formatting.",
      "command": "deno fmt --check"
    },
    "readme": {
      "description": "Generate README.md.",
      "command": "sh -c 'temp=$(mktemp README.md.XXXXXX) && trap \"rm -f \\\"$temp\\\"\" EXIT && deno run --allow-read=. jsr:@hugojosefson/cli@0.16.1 readme build > \"$temp\" && chmod a-w \"$temp\" && mv -f \"$temp\" README.md'"
    },
    "default": {
      "description": "Fix formatting, then run checks.",
      "command": "deno task --if-present package-metadata && deno task fmt && deno task readme && deno task check"
    },
    "package-metadata": {
      "description": "Build bundled CLI package metadata from Deno configuration.",
      "command": "sh -c 'temp=$(mktemp src/cli/package-metadata.json.XXXXXX) && trap \"rm -f \\\"$temp\\\"\" EXIT && deno run --allow-read=. jsr:@hugojosefson/cli@0.16.1 package build > \"$temp\" && chmod 644 \"$temp\" && mv \"$temp\" src/cli/package-metadata.json'"
    },
    "lint": {
      "description": "Fix lint locally; check lint in CI.",
      "command": "sh -c 'if test -n \"${CI:-}\"; then exec deno lint; else exec deno lint --fix; fi'"
    },
    "typecheck": {
      "description": "Type-check the project.",
      "command": "deno check mod.ts 'src/**/*.ts' 'test/**/*.ts' 'readme/**/*.ts'"
    },
    "test": {
      "description": "Run tests.",
      "command": "deno test --allow-run=cat,sh"
    },
    "test-compiled-consumer": {
      "description": "Test the public API from a compiled consumer with dummy SSH.",
      "command": "bash test/compiled-consumer.sh"
    },
    "publish-check": {
      "description": "Check JSR publication.",
      "command": "deno publish --dry-run --allow-dirty --check=all"
    }
  },
  "publish": {
    "include": [
      "src/",
      "mod.ts",
      "readme/example-usage.ts",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": ["src/**/*.test.ts"]
  },
  "lock": true,
  "minimumDependencyAge": "0",
  "imports": {
    "@core/streamutil": "jsr:@core/streamutil@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/streams": "jsr:@std/streams@^1.2.0",
    "xstate": "npm:xstate@^5.33.2",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "fmt": {
    "exclude": [
      ".idea",
      "coverage",
      "README.md"
    ]
  }
}
